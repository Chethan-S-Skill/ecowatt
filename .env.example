# EcoWatt AI - Environment Configuration Example
SECRET_KEY=replace-with-a-secure-random-jwt-secret-key
DATABASE_URL=sqlite:///./ecowatt.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/ecowatt
METER_API_KEY=campus-meter-secret-key-2026

# Default Users (Seeded automatically)
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=AdminCampus#2026
VIEWER_EMAIL=viewer@campus.edu
VIEWER_PASSWORD=ViewerCampus#2026

# Campus Energy Settings
DEFAULT_TARIFF_INR=8.0
DEFAULT_EMISSION_FACTOR=0.82

# AI LLM Keys (Optional - graceful offline template fallback if omitted or offline)
GEMINI_API_KEY=
KIMI_API_KEY=
SARVAM_API_KEY=
ANTHROPIC_API_KEY=

# Email Alerts (Optional SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=facility.manager@campus.edu
